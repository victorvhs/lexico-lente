---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - nav
    - post
    - posts
    - tagList
permalink: /tags/{{ tag | slugify }}/
eleventyComputed:
  title: 'Tag: {{ tag }}'
layout: base.njk
---

<h2 class="post-title" style="margin-top:0;">
  Posts marcados com &ldquo;{{ tag }}&rdquo;
</h2>

{% set taglist = collections[tag] | reverse %}

{% for post in taglist %}
<article class="post">
  <div class="post-header">
    <h2 class="post-title">
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </h2>
    <p class="post-meta">
      <time datetime="{{ post.date | dateISO }}">{{ post.date | dateFormat }}</time>
    </p>
  </div>
  <div class="post-body">
    <p class="post-excerpt">{{ post.data.description or (post.content | resumo(220)) }}</p>
    <p class="leia-mais"><a href="{{ post.url }}">[ Ler mais &rarr; ]</a></p>
  </div>
</article>
{% endfor %}

<p class="leia-mais" style="margin-top:20px;">
  <a href="/">&larr; Voltar para a página inicial</a>
</p>

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} :: {% endif %}{{ site.title }}</title>
  {% set metaDesc = description or site.subtitle %}
  <meta name="description" content="{{ metaDesc }}">
  <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}">
  <meta property="og:description" content="{{ metaDesc }}">
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ site.title }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='14'>&#9998;</text></svg>">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<a class="skip-link" href="#content">Pular para o conteúdo</a>

<div id="container">

  <!-- HEADER -->
  <header id="header">
    <h1><a href="/">{{ site.title }}</a></h1>
    <p class="subtitle">{{ site.subtitle }}</p>
  </header>

  <!-- MAIN LAYOUT -->
  <div id="main">

    <!-- CENTER: Conteúdo (primeiro no HTML: no celular vem antes das laterais) -->
    <main id="content">
      {{ content | safe }}
    </main>

    <!-- LEFT SIDEBAR: Ferramentas Úteis -->
    <aside id="leftbar">
      <h3>Ferramentas Úteis</h3>

      <a class="banner" href="https://www.vim.org" target="_blank" rel="noopener">
        <strong>[ VIM ]</strong>
        Editor supremo desde 1991
      </a>

      <a class="banner" href="https://www.rust-lang.org" target="_blank" rel="noopener">
        <strong>[ RUST ]</strong>
        Memória segura, zero GC
      </a>

      <a class="banner" href="https://www.11ty.dev" target="_blank" rel="noopener">
        <strong>[ 11ty ]</strong>
        Gerador estático simples
      </a>

      <a class="banner" href="https://archive.org" target="_blank" rel="noopener">
        <strong>[ IA ]</strong>
        Internet Archive
      </a>

      <a class="banner" href="https://github.com" target="_blank" rel="noopener">
        <strong>[ Git ]</strong>
        Social coding
      </a>

      <a class="banner" href="https://openbsd.org" target="_blank" rel="noopener">
        <strong>[ *BSD ]</strong>
        Free like freedom
      </a>

      <hr class="sidebar-rule">

      <p class="partner-footer">
        Ferramentas que uso.<br>
        Sugestões? <a href="mailto:{{ site.email }}">mande um e-mail</a>.
      </p>
    </aside>

    <!-- RIGHT SIDEBAR: Arquivo & Tags -->
    <aside id="rightbar">

      <div class="section">
        <h3>Arquivo</h3>
        {% set postsByYear = collections.posts | groupByYear %}
        <ul class="archive-list">
        {% for year, yearPosts in postsByYear %}
          <li class="year">{{ year }}</li>
          {% for post in yearPosts | reverse %}
          <li>
            <a href="{{ post.url }}">{{ post.data.title }}</a>
            <span class="archive-date">{{ post.date | dateFormat }}</span>
          </li>
          {% endfor %}
        {% endfor %}
        </ul>
      </div>

      <div class="section">
        <h3>Tags</h3>
        <ul class="tag-list">
        {% for tag in collections.tagList %}
          <li><a href="/tags/{{ tag | slugify }}/">{{ tag }}</a></li>
        {% endfor %}
        </ul>
      </div>

      <div class="section">
        <h3>Sobre</h3>
        <p class="about-text">
          Blog escrito em Markdown, compilado com Eleventy e hospedado no
          GitHub Pages. Layout inspirado na web dos anos 2000.
          <a href="/sobre/">Saiba mais →</a>
        </p>
      </div>

      <div class="section">
        <h3>RSS</h3>
        <p class="rss-link">
          <a href="/feed.xml">📡 Feed Atom</a>
        </p>
      </div>

    </aside>

  </div>

  <!-- FOOTER -->
  <footer id="footer">
    <p>
      {{ site.title }} :: Feito com ❤️ e poucos bytes ::
      <a href="{{ site.repo }}">Código fonte</a>
    </p>
  </footer>

</div>

</body>
</html>
